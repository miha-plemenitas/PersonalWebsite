{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:test": "cross-env NEXT_PUBLIC_GOOGLE_CLIENT_ID=stamp-test-only.apps.googleusercontent.com next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cd testing && mvnw test",
    "test:qr": "cd testing && mvn test -Dtest=QrDownloadTests",
    "mcp:browser": "npx -y @playwright/mcp@0.0.86 --isolated --browser msedge --codegen java --no-webmcp --allowed-origins \"http://127.0.0.1:*;http://localhost:*\" --output-dir testing/target/mcp --port 8931"
  },
  "dependencies": {
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^14.14.0",
    "next": "^15.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.6.3"
  }
}
