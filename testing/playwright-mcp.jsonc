{
  "$schema": "https://opencode.ai/config.json",
  "name": "playwright-browser",
  "description": "Shared Playwright MCP browser service for local test investigation. Agent-neutral: any MCP client can connect to it.",
  "command": [
    "cmd.exe", "/c", "npx", "-y", "@playwright/mcp@0.0.86",
    "--isolated", "--browser", "msedge", "--codegen", "java",
    "--no-webmcp", "--allowed-origins", "http://127.0.0.1:*;http://localhost:*",
    "--output-dir", "testing/target/mcp"
  ],
  "port": 8931,
  "endpoint": "http://localhost:8931/",
  "notes": [
    "Visible browser by default. Add --headless to command for CI.",
    "Start with: npm run mcp:browser",
    "Connect Claude Code: claude mcp add --transport sse playwright http://localhost:8931/",
    "Connect Codex: codex mcp add playwright --url http://localhost:8931/",
    "The Java test suite (mvn test) does NOT use this server. It runs Playwright Java independently."
  ]
}